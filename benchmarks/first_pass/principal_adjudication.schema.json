{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prismml.ai/schemas/first-pass-principal-adjudication.v1.json",
  "title": "Prism Vault principal review adjudication",
  "type": "object",
  "required": [
    "adjudication_id",
    "principal_reviewer_id",
    "qualification",
    "packet_sha256",
    "reviewer_pubkey",
    "buzz_event_id",
    "adjudicated_at",
    "decisions"
  ],
  "properties": {
    "adjudication_id": {"type": "string", "minLength": 1},
    "principal_reviewer_id": {"type": "string", "minLength": 1},
    "qualification": {"type": "string", "minLength": 1},
    "packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer_pubkey": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "buzz_event_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "adjudicated_at": {"type": "string", "format": "date-time"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "dimension", "final_label", "rationale"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "dimension": {"type": "string", "minLength": 1},
          "final_label": {"enum": ["pass", "fail"]},
          "rationale": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
