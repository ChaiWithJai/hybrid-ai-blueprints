{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prismml.ai/schemas/candidate-source-review-submission.v2.json",
  "title": "Prism candidate source review submission",
  "type": "object",
  "required": [
    "review_id", "reviewer_id", "reviewer_role", "qualification",
    "blinded_to_model", "packet_sha256", "reviewer_pubkey", "buzz_event_id", "reviewed_at", "drafts"
  ],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewer_role": {"enum": ["qualified_deal_source_reviewer"]},
    "qualification": {"type": "string", "minLength": 1},
    "blinded_to_model": {"enum": [true]},
    "packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer_pubkey": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "buzz_event_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "drafts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "draft_id", "source_sha256s", "source_context_checked", "decision",
          "final_question", "answer_policy", "supporting_citations",
          "confusable_citations", "expected_claims", "absence_basis", "rationale"
        ],
        "properties": {
          "draft_id": {"type": "string", "minLength": 1},
          "source_sha256s": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "source_context_checked": {"enum": [true]},
          "decision": {"enum": ["approve", "revise", "reject"]},
          "final_question": {"type": "string"},
          "answer_policy": {"enum": ["supported", "refuse_absent", "unresolved"]},
          "supporting_citations": {
            "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
          },
          "confusable_citations": {
            "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
          },
          "expected_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "citations"],
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "citations": {
                  "type": "array", "minItems": 1,
                  "items": {"type": "string", "minLength": 1}, "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          },
          "absence_basis": {"type": "string"},
          "rationale": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
