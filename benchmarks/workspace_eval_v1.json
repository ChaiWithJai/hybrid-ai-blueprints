  "agentic_workflows": [
    {
      "id": "workflow_source_bound_answer",
      "description": "Retrieve the debt table, invoke local Bonsai, pass the publication guard, sign to Buzz, and render the answer.",
      "evidence_file": "evidence/browser-titan-debt-chat-v1.json",
      "transitions": [
        {"from": "question", "to": "retrieved evidence", "assertion": "source_hash_and_anchor_bound"},
        {"from": "retrieved evidence", "to": "guarded answer", "assertion": "capital_structure_contract_bound"},
        {"from": "guarded answer", "to": "signed Buzz event", "assertion": "accepted_answer_signature_verified"},
        {"from": "signed Buzz event", "to": "human-visible answer", "assertion": "human_debt_label_and_values_visible"}
      ]
    },
    {
      "id": "workflow_guard_recovery",
      "description": "Keep the failed attempt, retry once, and publish only the source-bound answer.",
      "evidence_file": "evidence/browser-titan-debt-chat-v1.json",
      "transitions": [
        {"from": "first generation", "to": "rejection retained", "assertion": "prior_rejection_retained"},
        {"from": "retry", "to": "publication guard pass", "assertion": "every_debt_instrument_visible_in_signed_answer"},
        {"from": "published event", "to": "restart restoration", "assertion": "accepted_trace_restored_after_restart"}
      ]
    },
    {
      "id": "workflow_citation_followup",
      "description": "Preview a cited passage without losing place, carry it into chat, and open the exact full source when needed.",
      "evidence_file": "evidence/browser-customer-demo-v1.json",
      "transitions": [
        {"from": "citation", "to": "in-place passage", "assertion": "citation_preview_preserves_current_view"},
        {"from": "in-place passage", "to": "scoped composer", "assertion": "citation_context_reaches_persistent_composer"},
        {"from": "in-place passage", "to": "exact full source", "assertion": "citation_preview_opens_exact_full_source"}
      ]
    }
  ],
