{
  "slug": "remittance_records",
  "version": 1,
  "sync_mode": "opt_in",
  "properties": {
    "sourceText":   {"type": "string", "required": true},
    "sourceRefId":  {"type": "string", "required": true},
    "lang":         {"type": "string", "required": true},
    "amountMinor":  {"type": "int"},
    "currency":     {"type": "string"},
    "channel":      {"type": "string",
                     "enum": ["remitly", "wise", "wallet", "cash",
                              "informal", "unknown"]},
    "purpose":      {"type": "string"},
    "extractionConfidence": {"type": "float"},
    "humanConfirmed": {"type": "bool", "default": false},
    "extractMode":  {"type": "string",
                     "enum": ["model", "confirm_needed", "fallback"]}
  },
  "client_actions": [
    {"name": "extract", "params": {"confidence_floor": 0.8}}
  ]
}
