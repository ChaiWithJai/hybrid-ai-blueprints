{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hybrid-ai-blueprints.dev/schemas/blueprint.schema.json",
  "title": "Hybrid AI Blueprint",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "version",
    "status",
    "use_case",
    "model",
    "harness",
    "interface",
    "evaluation",
    "demos",
    "commands",
    "release_claim"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["proposed", "prototype", "supported", "deprecated"]},
    "use_case": {"type": "string"},
    "model": {"type": "object"},
    "harness": {"type": "object"},
    "interface": {"type": "object"},
    "evaluation": {"type": "object"},
    "demos": {"type": "array", "minItems": 1},
    "commands": {"type": "object"},
    "release_claim": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
