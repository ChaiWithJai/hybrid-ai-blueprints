{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hybrid-ai-blueprints.dev/schemas/use-case.schema.json",
  "title": "Hybrid AI Blueprint use case",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "job",
    "primary_user",
    "value_unit",
    "task_contracts",
    "blueprints"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "prototype", "supported", "deprecated"]},
    "job": {"type": "string", "minLength": 1},
    "primary_user": {"type": "string", "minLength": 1},
    "value_unit": {"type": "string", "minLength": 1},
    "task_contracts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "blueprints": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
