{
  "schema_version": 1,
  "benchmark_id": "prism_xlsx_display_fidelity_v1",
  "measurement_state": "spec_derived_parser_regression_not_excel_parity",
  "expected_value_authority": "Manually preregistered from the stated OOXML number-format semantics. Expected values are not generated by the Prism parser.",
  "cases": [
    {
      "case_id": "fixed_decimal",
      "label": "Entry multiple",
      "raw_value": "12.346",
      "format_code": "0.00",
      "expected_display": "12.35",
      "expected_formatting_state": "display_format_applied",
      "formula": null,
      "expected_calculation_state": "literal_value"
    },
    {
      "case_id": "grouped_decimal",
      "label": "Enterprise value",
      "raw_value": "1234567.8",
      "format_code": "#,##0.00",
      "expected_display": "1,234,567.80",
      "expected_formatting_state": "display_format_applied",
      "formula": null,
      "expected_calculation_state": "literal_value"
    },
    {
      "case_id": "currency",
      "label": "Implementation fee",
      "raw_value": "1234.5",
      "format_code": "$#,##0.00",
      "expected_display": "$1,234.50",
      "expected_formatting_state": "display_format_applied",
      "formula": null,
      "expected_calculation_state": "literal_value"
    },
    {
      "case_id": "cached_percent_formula",
      "label": "First-year ROI",
      "raw_value": "99.97222222",
      "format_code": "0.0%",
      "expected_display": "9997.2%",
      "expected_formatting_state": "display_format_applied",
      "formula": "B6/B7",
      "expected_calculation_state": "cached_value_not_recalculated"
    },
    {
      "case_id": "percentage_literal",
      "label": "Margin",
      "raw_value": "0.2574",
      "format_code": "0.0%",
      "expected_display": "25.7%",
      "expected_formatting_state": "display_format_applied",
      "formula": null,
      "expected_calculation_state": "literal_value"
    },
    {
      "case_id": "multiple_suffix",
      "label": "Debt to EBITDA",
      "raw_value": "6.39",
      "format_code": "0.00\\x",
      "expected_display": "6.39x",
      "expected_formatting_state": "display_format_applied",
      "formula": null,
      "expected_calculation_state": "literal_value"
    },
    {
      "case_id": "unsupported_date",
      "label": "Closing date serial",
      "raw_value": "45292",
      "format_code": "mm-dd-yy",
      "expected_display": "45292",
      "expected_formatting_state": "raw_unsupported_format",
      "formula": null,
      "expected_calculation_state": "literal_value"
    },
    {
      "case_id": "unsupported_scientific",
      "label": "Scientific input",
      "raw_value": "1250000",
      "format_code": "0.00E+00",
      "expected_display": "1250000",
      "expected_formatting_state": "raw_unsupported_format",
      "formula": null,
      "expected_calculation_state": "literal_value"
    },
    {
      "case_id": "uncached_formula",
      "label": "Unsaved formula",
      "raw_value": null,
      "format_code": "0.00",
      "expected_display": "[formula not calculated] =B2*2",
      "expected_formatting_state": "not_applicable",
      "formula": "B2*2",
      "expected_calculation_state": "formula_without_cached_value"
    }
  ],
  "limitations": [
    "This benchmark checks Prism's declared bounded formatting subset, not full Excel display parity.",
    "It does not execute or recalculate formulas.",
    "Expected displays are preregistered test data, not output from Excel or LibreOffice.",
    "Dates, scientific notation, multi-section formats, bracketed formats, locale rules, and conditional formats remain unsupported."
  ]
}
