{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prismml.ai/schemas/first-pass-case.v1.json",
  "title": "Prism Vault first pass benchmark case",
  "type": "object",
  "required": [
    "id",
    "version",
    "deal_id",
    "near_duplicate_family_id",
    "split",
    "task_family",
    "question",
    "investment_screen",
    "answer_policy",
    "severity",
    "requested_components",
    "required_claims",
    "required_citations",
    "calculations",
    "acceptable_absence_terms",
    "forbidden_claims",
    "slices",
    "source_snapshot_sha256",
    "domain_review"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "deal_id": {
      "type": "string",
      "minLength": 1
    },
    "near_duplicate_family_id": {
      "type": ["string", "null"]
    },
    "split": {
      "enum": ["development", "calibration", "sealed_test"]
    },
    "task_family": {
      "enum": [
        "transaction_identity_structure_chronology",
        "purchase_price_and_valuation",
        "financing_and_capital_structure",
        "financial_quality_and_earnings_adjustments",
        "contract_terms_covenants_and_approvals",
        "market_and_regulatory_findings",
        "risks_conflicts_and_missing_information",
        "cross_document_synthesis_and_recommendation"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "investment_screen": {
      "type": ["string", "null"]
    },
    "answer_policy": {
      "enum": ["answer", "refuse_absent", "report_conflict"]
    },
    "severity": {
      "enum": ["critical", "major", "minor"]
    },
    "requested_components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "severity", "citation_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "major", "minor"]},
          "citation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "required_citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "filename", "anchor", "source_sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "minLength": 1},
          "anchor": {"type": "string", "minLength": 1},
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence_excerpt_sha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "calculations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "formula", "expected_value", "unit", "tolerance", "input_claim_ids", "inputs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "formula": {"type": "string", "minLength": 1},
          "expected_value": {"type": "number"},
          "unit": {"type": "string", "minLength": 1},
          "tolerance": {"type": "number", "minimum": 0},
          "input_claim_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "claim_id", "value", "unit"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "claim_id": {"type": "string", "minLength": 1},
                "value": {"type": "number"},
                "unit": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "acceptable_absence_terms": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "forbidden_claims": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "slices": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "domain_review": {
      "type": "object",
      "required": ["status", "owner", "reviewed_at"],
      "properties": {
        "status": {"enum": ["not_reviewed", "approved", "rejected"]},
        "owner": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
