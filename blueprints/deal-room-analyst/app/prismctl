    providers = ProviderRegistry()

    print("=" * 75)
    print("  PRISM VAULT: INSTALLED CAPABILITIES")
    print("=" * 75)
    print("\n[RUNTIMES]")
    for status in providers.statuses():
        state = "CONFIGURED" if status.configured else "NOT CONFIGURED"
        print(f"  • {status.provider_id:<14}: {state} ({status.model or 'no model'})")
    print("  • baseline      : READY (deterministic reviewed templates; no LLM)")
    print("\n[BOUNDARIES]")
    print("  • Web bind      : loopback by default; not a certified air-gap")
    print("  • Sandbox       : AST allowlist + subprocess resource limits; not VM isolation")
    print("  • Bonsai math   : architecture projection only; no bundled weights or megakernel")

    print("\n[AVAILABLE DEAL ROOMS]")
    for rid, rdata in DEAL_ROOM_CATALOG.items():
        print(f"  • [{rdata['type']:<22}] {rdata['name']} ({rdata['path']})")

    print("\n[APPLICATION WORKFLOW TIERS]")
    print("  ├── Folder ingestion         : READY for Markdown/text, CSV, and JSON")
    print("  ├── Reviewed workflows       : PROTOTYPE (deterministic baseline)")
    print("  ├── Bonsai local AI          : READY only when local provider is configured")
    print("  └── Web workspace            : PROTOTYPE (run 'prismctl serve')")
    print("=" * 75)


