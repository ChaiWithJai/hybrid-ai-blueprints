#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(cd "${SCRIPT_DIR}/../app" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"

# Catalog validators live at the repository root and check the whole catalog.
cd "${REPO_ROOT}"
python3 tooling/catalog/validate_catalog.py
python3 tooling/documentation/validate_links.py

# The application suite runs from the application root.
cd "${APP_DIR}"
exec python3 -m unittest discover -s tests
