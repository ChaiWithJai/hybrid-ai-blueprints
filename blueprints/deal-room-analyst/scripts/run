#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(cd "${SCRIPT_DIR}/../app" && pwd)"

# The application root is the Python import root, so `import core` resolves and
# every Path(__file__).resolve().parents[1] inside it points here.
cd "${APP_DIR}"
exec python3 scripts/run_v0.py "$@"
